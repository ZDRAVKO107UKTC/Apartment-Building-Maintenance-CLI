# Copy this file to .env and fill in real values. Never commit .env.
# All values are injected into the application container by docker-compose.

# --- Database (SQLite) ---
# Path to the SQLite database file. Inside Docker this lives on a mounted
# volume so data persists across container restarts.
DB_PATH=/data/maintenance.db

# --- SendGrid email integration (3rd-party API) ---
# Leave blank to disable email notifications (the app logs and continues).
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@example.com
MANAGER_EMAIL=manager@example.com
